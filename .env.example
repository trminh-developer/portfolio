# Existing contact form integration. Without all three values, the homepage
# opens the visitor's email application with the message prefilled.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: enable the template's Google sign-in and public comments.
# Enable Google authentication and configure authorized domains in Firebase.
# Firestore collection: portfolioComments. Configure security rules before use.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
